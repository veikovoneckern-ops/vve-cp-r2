[Unit]
Description=VvE Cockpit (neue Fassung): Plaud-Sprachnotizen abrufen
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/vve-cp-r2
EnvironmentFile=-%h/.config/vve-cp-r2.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Schnellpruefung: nur Seite 1 ansehen, der volle Lauf nur bei Unbekanntem (cockpit/plaud.py).
ExecStart=%h/vve-cp-r2/.venv/bin/python -m cockpit.plaud --schnell
TimeoutStartSec=15min
Nice=5
